# Never commit a populated .env file.
PORT=8787
HOST=127.0.0.1
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
CODEX_PROJECT_DIR=C:\\path\\to\\your\\project
# A 16+ character private passphrase. It is requested by the local voice page.
LOCAL_ACCESS_TOKEN=change-this-to-a-long-private-value
# Default is read-only. Turn on only after you have tested the bridge.
VOICE_WRITE_ENABLED=false
# Optional: only for the paid Twilio phone-call adapter.
PUBLIC_BASE_URL=
ALLOWED_CALLERS=
TWILIO_AUTH_TOKEN=
