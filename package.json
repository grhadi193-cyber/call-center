{
  "name": "voice-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A guarded telephony-to-Gemini-Live-to-Codex bridge.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
