    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "@fastify/websocket": "11.3.0",
    "@google/genai": "3.3.0",
